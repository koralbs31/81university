LEARNHOUSE_SQL_CONNECTION_STRING=postgresql+asyncpg://learnhouse:URL_ENCODED_PASSWORD@postgres.example.com:5432/learnhouse
LEARNHOUSE_REDIS_CONNECTION_STRING=rediss://default:URL_ENCODED_PASSWORD@redis.example.com:6379/0
LEARNHOUSE_AUTH_JWT_SECRET_KEY=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS

# Required for the default Cloudflare R2 media backend.
LEARNHOUSE_S3_API_BUCKET_NAME=REPLACE_WITH_BUCKET_NAME
LEARNHOUSE_S3_API_ENDPOINT_URL=https://REPLACE_WITH_ACCOUNT_ID.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_ACCESS_KEY

# Optional Google login: use the same client ID as the web Secret.
# LEARNHOUSE_GOOGLE_OAUTH_CLIENT_ID=REPLACE_WITH_CLIENT_ID.apps.googleusercontent.com

# Optional email: configure one provider (Resend shown here).
# LEARNHOUSE_EMAIL_PROVIDER=resend
# LEARNHOUSE_RESEND_API_KEY=REPLACE_WITH_RESEND_KEY
# LEARNHOUSE_SYSTEM_EMAIL_ADDRESS=noreply@school.example.com
# LEARNHOUSE_SYSTEM_EMAIL_SENDER_NAME=Your School

# Optional executable coding exercises.
# LEARNHOUSE_JUDGE0_API_URL=https://judge0.example.com
# LEARNHOUSE_JUDGE0_CLIENT_ID=REPLACE_IF_REQUIRED
# LEARNHOUSE_JUDGE0_CLIENT_SECRET=REPLACE_IF_REQUIRED
