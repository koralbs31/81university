{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "domain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
    },
    "https": {
      "type": "boolean"
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "api": {
      "$ref": "#/definitions/service"
    },
    "web": {
      "$ref": "#/definitions/service"
    },
    "migration": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "bootstrapExistingSecret": {
          "type": "string"
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "ttlSecondsAfterFinished": {
          "type": "integer",
          "minimum": 0
        },
        "resources": {
          "type": "object"
        }
      },
      "required": [
        "enabled",
        "bootstrapExistingSecret",
        "activeDeadlineSeconds",
        "ttlSecondsAfterFinished",
        "resources"
      ]
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string",
          "minLength": 1
        },
        "tlsSecretName": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "enabled",
        "className",
        "tlsSecretName",
        "annotations"
      ]
    },
    "contentStorage": {
      "type": "object",
      "required": [
        "region"
      ],
      "properties": {
        "region": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "domain",
    "https",
    "imagePullSecrets",
    "api",
    "web",
    "migration",
    "ingress",
    "contentStorage"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "api": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "api": {
            "properties": {
              "existingSecret": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "migration": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "migration": {
            "properties": {
              "bootstrapExistingSecret": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "api": {
            "properties": {
              "existingSecret": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ingress": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "https": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "ingress": {
            "properties": {
              "tlsSecretName": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ingress": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "anyOf": [
          {
            "properties": {
              "api": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                }
              }
            }
          },
          {
            "properties": {
              "web": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                }
              }
            }
          }
        ]
      }
    }
  ],
  "definitions": {
    "service": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          },
          "required": [
            "repository",
            "tag",
            "pullPolicy"
          ]
        },
        "existingSecret": {
          "type": "string"
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "resources": {
          "type": "object"
        }
      },
      "required": [
        "enabled",
        "replicas",
        "image",
        "existingSecret",
        "env",
        "resources"
      ]
    }
  },
  "not": {
    "anyOf": [
      {
        "required": [
          "persistence"
        ]
      },
      {
        "properties": {
          "api": {
            "properties": {
              "env": {
                "properties": {
                  "LEARNHOUSE_CONTENT_DELIVERY_TYPE": {
                    "const": "filesystem"
                  }
                },
                "required": [
                  "LEARNHOUSE_CONTENT_DELIVERY_TYPE"
                ]
              }
            }
          }
        }
      }
    ]
  }
}
